VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_ADMIN_PASSWORD=your-admin-password

# ImgBB - Free image hosting (get your API key at https://api.imgbb.com/)
VITE_IMGBB_API_KEY=your-imgbb-api-key

# Umami - Analytics via Share URL pública (funciona no plano Hobby, sem API Pro)
# Habilite em: Websites -> Edit -> Share URL -> Add -> Save
# Use a URL completa; a região (eu/us) é detetada automaticamente após o redirect.
VITE_UMAMI_SHARE_URL=https://cloud.umami.is/share/xxxxxxxx
# Opcional, só se a deteção automática falhar:
# VITE_UMAMI_REGION=eu
